[codespell]
skip = .git,.venv,dist,__pycache__,*.lock,uv.lock,./.agents/skills,./reference
ignore-words-list = constitucion,requiere,ser,contener,inicial,funcional,identificable,comando,comandos,posible,fase,fases,autor,relevante,falso,aplicable,formen,controles,pase,aspectos,diagrama,responsable,visibles,componentes,potencial,accesible,rige,imposible,cliente,asume,referencial,historial,previos,oficial,manifiestos,convencional,implemente,avance,responde,confirmas,leas,inmutables,momento,utiliza
